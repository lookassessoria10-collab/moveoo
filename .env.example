# Copie para .env.local e ajuste.

# "local" = hospedagem nesta máquina (caixa de saída visível, cookies sem HTTPS).
# Deixe vazio em qualquer servidor acessível pela internet.
MOVEO_AMBIENTE=local

# Opcional: endereço usado nos links de convite. Sem isto, usa o endereço pelo qual o painel foi aberto.
# MOVEO_BASE_URL=http://192.168.1.11:3000

# Opcional: pasta do banco local (padrão: .data/pglite)
# MOVEO_DB_DIR=
